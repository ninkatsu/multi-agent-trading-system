# ============================================
# 多Agent量化交易系统 - 环境变量模板
# 复制此文件为 .env 并填入你自己的密钥
#   cp .env.example .env
# ============================================

# --- LLM 配置 (默认: DeepSeek) ---
# provider: deepseek(默认) / openai / anthropic
LLM_PROVIDER=deepseek
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# DeepSeek API (OpenAI 兼容端点, 默认推荐)
# 注册获取 Key: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# DeepSeek Anthropic 兼容端点 (备选, 同样可用)
# ANTHROPIC_AUTH_TOKEN=sk-your-deepseek-api-key
# ANTHROPIC_MODEL=deepseek-v4-pro
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# OpenAI 兼容路径 (仅当 LLM_PROVIDER=openai 时生效)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_BASE_URL=

# --- 市场数据代理（墙内访问 Yahoo Finance 可能需要）---
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# --- 股票交易 API (Alpaca 模拟盘) ---
ALPACA_API_KEY=your-alpaca-api-key
ALPACA_SECRET_KEY=your-alpaca-secret-key
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- 数据源配置 ---
# yfinance 无需 API Key（美股数据）
# NewsAPI (新闻情绪分析, 免费: https://newsapi.org)
NEWS_API_KEY=your-news-api-key

# --- 风控参数 (股票版) ---
MAX_POSITION_SIZE=0.1
MAX_DRAWDOWN_LIMIT=0.08
STOP_LOSS_PCT=0.05
TAKE_PROFIT_PCT=0.15
MAX_PORTFOLIO_RISK=0.02

# --- 风控参数 (基金版) ---
# 基金风控阈值按类型动态设定，详见 fund/agents/risk_agent.py
FUND_MAX_POSITION_EQUITY=0.25
FUND_MAX_POSITION_INDEX=0.30
FUND_MAX_POSITION_BOND=0.50
FUND_MAX_DRAWDOWN_EQUITY=0.12
FUND_MAX_DRAWDOWN_BOND=0.04

# --- 回测配置 ---
BACKTEST_START_DATE=2025-01-01
BACKTEST_END_DATE=2025-08-31
INITIAL_CAPITAL=1000000
