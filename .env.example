# ============================================
# 多Agent量化交易系统 - 环境变量模板
# 复制此文件为 .env 并填入你自己的密钥
# cp .env.example .env
# ============================================

# --- LLM API 配置 ---
# provider: anthropic(默认, 可走智谱GLM兼容端点) / openai
LLM_PROVIDER=anthropic
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# Anthropic 兼容端点（智谱 GLM，墙内直连）
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
ANTHROPIC_MODEL=glm-5.2
ANTHROPIC_AUTH_TOKEN=your-glm-token-here

# OpenAI 兼容路径（仅当 LLM_PROVIDER=openai 时生效）
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_BASE_URL=

# --- 市场数据代理（墙内访问 Yahoo Finance 必备）---
# yfinance 默认访问 Yahoo，国内多被墙；有代理请取消注释填写
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# --- 交易API配置 ---
# Alpaca (模拟交易，免费注册: https://alpaca.markets)
ALPACA_API_KEY=your-alpaca-api-key
ALPACA_SECRET_KEY=your-alpaca-secret-key
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- 数据源配置 ---
# yfinance 无需API Key，直接可用
# NewsAPI (新闻情绪分析，免费: https://newsapi.org)
NEWS_API_KEY=your-news-api-key

# --- 风控参数 ---
MAX_POSITION_SIZE=0.1
MAX_DRAWDOWN_LIMIT=0.08
STOP_LOSS_PCT=0.05
TAKE_PROFIT_PCT=0.15
MAX_PORTFOLIO_RISK=0.02

# --- 回测配置 ---
BACKTEST_START_DATE=2025-01-01
BACKTEST_END_DATE=2025-08-31
INITIAL_CAPITAL=1000000
