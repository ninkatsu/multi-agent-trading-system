# ====================================================================
#  多Agent量化交易系统 - 环境变量模板
#  使用方法: cp .env.example .env → 编辑 .env 填入密钥
# ====================================================================

# ============================
#  LLM 大模型配置
# ============================

# LLM提供商: deepseek(默认推荐) / openai / anthropic
#   deepseek   = DeepSeek API, 国内直连, 便宜好用
#   openai     = OpenAI GPT-4 及兼容端点
#   anthropic  = Anthropic Claude 及兼容端点
LLM_PROVIDER=deepseek

# DeepSeek API密钥 (在 https://platform.deepseek.com 免费注册获取)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# DeepSeek模型名称
#   deepseek-v4-pro = 最新旗舰模型 (推荐)
#   deepseek-chat   = 通用性价比模型
DEEPSEEK_MODEL=deepseek-v4-pro

# DeepSeek API地址
#   https://api.deepseek.com/v1         = OpenAI兼容端点 (推荐, 更稳定)
#   https://api.deepseek.com/anthropic  = Anthropic兼容端点 (备选)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# LLM温度 (0=最确定/保守, 1=最随机/创意, 金融分析推荐0.1-0.5)
LLM_TEMPERATURE=0.3

# LLM单次最大输出长度 (token数, 1个中文约2个token)
LLM_MAX_TOKENS=2048

# ============================
#  备选: Anthropic 兼容端点
# ============================

# 如果使用 Anthropic 兼容端点 (如 GLM/Claude), 填写以下配置:
# ANTHROPIC_AUTH_TOKEN=your-auth-token
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ============================
#  备选: OpenAI 兼容端点
# ============================

# 仅当 LLM_PROVIDER=openai 时生效
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_BASE_URL=

# ============================
#  网络代理 (墙内访问海外数据源时可能需要)
# ============================

# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ============================
#  股票版风控参数
# ============================

# 单只股票最大仓位占比 (0.1=10%, 100万组合单票最多买10万)
MAX_POSITION_SIZE=0.1

# 组合最大回撤容忍度 (0.08=8%, 100万最多允许亏8万)
MAX_DRAWDOWN_LIMIT=0.08

# 单笔止损比例 (0.05=5%, 买入后跌5%就自动止损)
STOP_LOSS_PCT=0.05

# 单笔止盈比例 (0.15=15%, 买入后涨15%就自动止盈)
TAKE_PROFIT_PCT=0.15

# 单票风险敞口上限 (0.02=2%, 最坏情况下单票损失不超过组合的2%)
MAX_PORTFOLIO_RISK=0.02

# ============================
#  基金版风控参数 (阈值按基金类型动态调整, 默认值)
#  详见: fund/agents/risk_agent.py 中的 FUND_RISK_RULES
# ============================

# 偏股/混合型基金单只仓位上限 (25%, 比股票版高因为基金本身已分散)
FUND_MAX_POSITION_EQUITY=0.25

# 指数型基金单只仓位上限 (30%, 指数更分散, 可放宽)
FUND_MAX_POSITION_INDEX=0.30

# 债券型基金单只仓位上限 (50%, 波动小可重仓)
FUND_MAX_POSITION_BOND=0.50

# 偏股基金最大回撤容忍度 (12%, 比股票版宽)
FUND_MAX_DRAWDOWN_EQUITY=0.12

# 债券基金最大回撤容忍度 (4%)
FUND_MAX_DRAWDOWN_BOND=0.04

# ============================
#  回测参数
# ============================

# 回测开始日期 (YYYY-MM-DD)
BACKTEST_START_DATE=2025-01-01

# 回测结束日期
BACKTEST_END_DATE=2025-08-31

# 回测初始资金 (元)
INITIAL_CAPITAL=1000000
